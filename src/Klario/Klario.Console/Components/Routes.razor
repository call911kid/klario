<Router AppAssembly="typeof(Routes).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" />
        <FocusOnNavigate RouteData="routeData" Selector="h1,h2" />
    </Found>
    <NotFound>
        <div style="padding: 3rem; text-align: center; color: var(--os-text-muted); font-family: var(--font-mono);">
            <h2>404 — Route Not Found</h2>
            <p style="margin-top: 1rem;"><a href="/" style="color: #0f766e;">Return to Klario Console</a></p>
        </div>
    </NotFound>
</Router>
