@namespace Klario.Console.Components.Common

@if (!string.IsNullOrWhiteSpace(State.ToastMessage))
{
    <div class="fixed bottom-5 right-5 z-50 flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 text-white text-xs shadow-lg border border-slate-800 font-medium animate-in fade-in slide-in-from-bottom-2 duration-200">
        <span class="w-2 h-2 rounded-full bg-teal-400"></span>
        <span>@State.ToastMessage</span>
    </div>
}
