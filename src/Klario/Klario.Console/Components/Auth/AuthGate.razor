@namespace Klario.Console.Components.Auth

<div class="relative z-10 w-full max-w-sm sm:max-w-md bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm flex flex-col">
    <div class="flex items-center gap-2 pb-4 mb-5 border-b border-slate-100">
        <span class="w-2.5 h-2.5 rounded-full bg-[#0f766e]"></span>
        <span class="font-bold text-sm tracking-wide text-slate-900">KLARIO</span>
    </div>

    <form class="space-y-4" @onsubmit="HandleUnlockAsync" @onsubmit:preventDefault>
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1.5">Secret Key <span class="text-rose-500">*</span></label>
            <div class="relative">
                <input type="@(showPassword ? "text" : "password")" 
                       class="w-full text-xs font-mono px-3.5 py-2.5 rounded-lg border border-slate-300 text-slate-900 bg-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0f766e] focus:border-[#0f766e] transition-all pr-10" 
                       placeholder="Enter secret..." 
                       value="@State.SecretKey" 
                       @oninput="OnSecretKeyInput"
                       autofocus 
                       spellcheck="false" />
                
                <button type="button" 
                        class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 p-1 transition-colors" 
                        @onclick="() => showPassword = !showPassword" 
                        title="Toggle visibility">
                    @if (showPassword)
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                            <line x1="1" y1="1" x2="23" y2="23"></line>
                        </svg>
                    }
                    else
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    }
                </button>
            </div>
        </div>

        <div class="h-9 flex items-center">
            @if (!string.IsNullOrWhiteSpace(State.GateError))
            {
                <div class="w-full flex items-center gap-2 px-3 py-1.5 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-xs font-mono">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-rose-500">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span class="truncate">@State.GateError</span>
                </div>
            }
        </div>

        <div class="flex items-center justify-between text-xs text-slate-500 pt-1">
            <label class="flex items-center gap-2 cursor-pointer select-none">
                <input type="checkbox" class="rounded accent-[#0f766e]" @bind="State.RememberKey" />
                <span>Remember secret</span>
            </label>

            <span class="font-mono text-[11px] text-slate-400">@State.ServerUrl</span>
        </div>

        <button type="submit" 
                class="w-full text-xs font-semibold font-mono py-2.5 px-4 rounded-lg bg-[#0f766e] hover:bg-[#115e59] text-white transition-colors shadow-xs flex items-center justify-center disabled:opacity-60 disabled:cursor-not-allowed" 
                disabled="@State.IsVerifying">
            @(State.IsVerifying ? "Verifying..." : "rm -rf unemployment")
        </button>
    </form>
</div>
